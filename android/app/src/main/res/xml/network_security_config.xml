<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed only for a Readle server on this phone/computer during development (adb reverse tcp:8787 tcp:8787,
     or the emulator's host alias). Everything else — including a deployed Readle server — must use https. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
